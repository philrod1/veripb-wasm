From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phil Rodgers <philip.rodgers@glasgow.ac.uk>
Date: Fri, 30 Oct 2026 13:42:35 +0000
Subject: [PATCH] Build progress::reporter on Unix only

Its one caller, the named-pipe path in checker::invoke, is Unix-only, so
other targets (such as wasm32-wasip1) warned that it was never used.
---
 src/checker/progress.rs | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/src/checker/progress.rs b/src/checker/progress.rs
index 65eac0b..5a3ba29 100644
--- a/src/checker/progress.rs
+++ b/src/checker/progress.rs
@@ -38,7 +38,8 @@ pub fn set_reporter(reporter: Option<Reporter>) {
     REPORTER.with(|current| *current.borrow_mut() = reporter);
 }
 
-/// The reporter installed on this thread, if any.
+/// The reporter installed on this thread, if any. Only Unix runs report.
+#[cfg(unix)]
 pub(crate) fn reporter() -> Option<Reporter> {
     REPORTER.with(|current| current.borrow().clone())
 }
