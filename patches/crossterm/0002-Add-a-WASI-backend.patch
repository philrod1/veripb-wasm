@@ -0,0 +1,65 @@
+//! WASI implementation of the terminal functions. The host (the program
+//! embedding the WebAssembly module) supplies the terminal size and the raw
+//! input bytes through the `crossterm_host` imports; output is written to
+//! stdout as ANSI sequences, as on unix.
+
+use std::io;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use crate::terminal::WindowSize;
+
+pub(crate) mod host {
+    #[link(wasm_import_module = "crossterm_host")]
+    unsafe extern "C" {
+        /// The terminal size as `columns << 16 | rows`.
+        pub(crate) fn terminal_size() -> u32;
+
+        /// Waits up to `timeout_ms` milliseconds (-1: no limit) for input and
+        /// copies at most `len` bytes of it to `buf`. Returns the number of
+        /// bytes copied, 0 on timeout, [`RESIZED`] if the terminal was resized,
+        /// or another negative value on failure.
+        pub(crate) fn read_input(buf: *mut u8, len: usize, timeout_ms: i32) -> i32;
+    }
+
+    /// `read_input` result: the terminal size changed.
+    pub(crate) const RESIZED: i32 = -2;
+}
+
+/// The host terminal has no line discipline; this flag only records the
+/// requested mode for `is_raw_mode_enabled`.
+static RAW_MODE: AtomicBool = AtomicBool::new(false);
+
+pub(crate) fn is_raw_mode_enabled() -> bool {
+    RAW_MODE.load(Ordering::Relaxed)
+}
+
+pub(crate) fn enable_raw_mode() -> io::Result<()> {
+    RAW_MODE.store(true, Ordering::Relaxed);
+    Ok(())
+}
+
+pub(crate) fn disable_raw_mode() -> io::Result<()> {
+    RAW_MODE.store(false, Ordering::Relaxed);
+    Ok(())
+}
+
+pub(crate) fn size() -> io::Result<(u16, u16)> {
+    let size = unsafe { host::terminal_size() };
+    Ok(((size >> 16) as u16, (size & 0xffff) as u16))
+}
+
+pub(crate) fn window_size() -> io::Result<WindowSize> {
+    let (columns, rows) = size()?;
+    Ok(WindowSize {
+        rows,
+        columns,
+        width: 0,
+        height: 0,
+    })
+}
+
+/// Progressive keyboard enhancement is not offered by the host.
+#[cfg(feature = "events")]
+pub fn supports_keyboard_enhancement() -> io::Result<bool> {
+    Ok(false)
+}
