+//! WASI event source: input bytes come from the host's `read_input`
+//! (`terminal/sys/wasi.rs`) and are parsed with the unix ANSI parser.
+
+use std::{collections::VecDeque, io, time::Duration};
+
+use crate::event::{
+    source::EventSource, sys::unix::parse::parse_event, timeout::PollTimeout, Event,
+    InternalEvent,
+};
+use crate::terminal::sys::wasi::host;
+
+const INPUT_BUFFER_SIZE: usize = 1_024;
+
+pub(crate) struct WasiEventSource {
+    parser: Parser,
+    input: [u8; INPUT_BUFFER_SIZE],
+}
+
+impl WasiEventSource {
+    pub fn new() -> io::Result<Self> {
+        Ok(WasiEventSource {
+            parser: Parser::default(),
+            input: [0; INPUT_BUFFER_SIZE],
+        })
+    }
+}
+
+impl EventSource for WasiEventSource {
+    fn try_read(&mut self, timeout: Option<Duration>) -> io::Result<Option<InternalEvent>> {
+        let timeout = PollTimeout::new(timeout);
+        loop {
+            if let Some(event) = self.parser.next() {
+                return Ok(Some(event));
+            }
+            let timeout_ms = match timeout.leftover() {
+                None => -1,
+                Some(left) => left.as_millis().min(i32::MAX as u128) as i32,
+            };
+            let read = unsafe {
+                host::read_input(self.input.as_mut_ptr(), INPUT_BUFFER_SIZE, timeout_ms)
+            };
+            match read {
+                host::RESIZED => {
+                    let (columns, rows) = crate::terminal::size()?;
+                    return Ok(Some(InternalEvent::Event(Event::Resize(columns, rows))));
+                }
+                n if n > 0 => {
+                    let n = n as usize;
+                    self.parser.advance(&self.input[..n], n == INPUT_BUFFER_SIZE);
+                }
+                n if n < 0 => {
+                    return Err(io::Error::other(format!(
+                        "crossterm_host.read_input failed ({n})"
+                    )));
+                }
+                _ => {
+                    if timeout.elapsed() {
+                        return Ok(None);
+                    }
+                }
+            }
+        }
+    }
+}
+
+/// Splits input bytes into events, as the unix mio source's parser does.
+#[derive(Debug)]
+struct Parser {
+    buffer: Vec<u8>,
+    internal_events: VecDeque<InternalEvent>,
+}
+
+impl Default for Parser {
+    fn default() -> Self {
+        Parser {
+            buffer: Vec::with_capacity(256),
+            internal_events: VecDeque::with_capacity(128),
+        }
+    }
+}
+
+impl Parser {
+    fn advance(&mut self, buffer: &[u8], more: bool) {
+        for (idx, byte) in buffer.iter().enumerate() {
+            let more = idx + 1 < buffer.len() || more;
+            self.buffer.push(*byte);
+            match parse_event(&self.buffer, more) {
+                Ok(Some(event)) => {
+                    self.internal_events.push_back(event);
+                    self.buffer.clear();
+                }
+                // Incomplete sequence: keep the bytes for the next call.
+                Ok(None) => {}
+                // Malformed sequence: drop it.
+                Err(_) => self.buffer.clear(),
+            }
+        }
+    }
+}
+
+impl Iterator for Parser {
+    type Item = InternalEvent;
+
+    fn next(&mut self) -> Option<Self::Item> {
+        self.internal_events.pop_front()
+    }
+}
