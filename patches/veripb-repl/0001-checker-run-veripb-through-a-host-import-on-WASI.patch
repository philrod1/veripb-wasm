From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phil Rodgers <philip.rodgers@glasgow.ac.uk>
Date: Wed, 21 Oct 2026 11:07:07 +0000
Subject: [PATCH 1/4] checker: run veripb through a host import on WASI

WASI has no subprocesses. On `target_os = "wasi"`, `invoke::run` passes
the veripb arguments to the host import `veripb_host.run_veripb` and reads
veripb's stdout and stderr back from files the host writes. Other targets
still spawn the `veripb` binary.
---
 src/checker/invoke.rs | 62 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 61 insertions(+), 1 deletion(-)

diff --git a/src/checker/invoke.rs b/src/checker/invoke.rs
index 8a9d098..7cba19f 100644
--- a/src/checker/invoke.rs
+++ b/src/checker/invoke.rs
@@ -2,11 +2,14 @@
 //! `veripb`, and returns its raw output.
 
 use std::ffi::{OsStr, OsString};
-use std::io::{BufRead, Read, Write};
+#[cfg(not(target_os = "wasi"))]
+use std::io::Read;
+use std::io::{BufRead, Write};
 use std::path::{Path, PathBuf};
 
 use anyhow::Context;
 
+#[cfg(not(target_os = "wasi"))]
 /// Returns the `veripb` binary to invoke: `$VERIPB_REPL_VERIPB_BIN` if
 /// set, otherwise `"veripb"` resolved via `$PATH`.
 fn veripb_binary() -> std::ffi::OsString {
@@ -101,6 +104,7 @@ struct Output {
 
 /// Runs `veripb` with `args`, reading its stdout a line at a time as it is
 /// written (see [`keep_lines`]) and its stderr whole.
+#[cfg(not(target_os = "wasi"))]
 fn run_veripb(args: &[OsString], consume: &mut dyn FnMut(&str) -> bool) -> anyhow::Result<Output> {
     let mut child = std::process::Command::new(veripb_binary())
         .args(args)
@@ -135,6 +139,23 @@ fn run_veripb(args: &[OsString], consume: &mut dyn FnMut(&str) -> bool) -> anyho
     })
 }
 
+/// Runs `veripb` through the host (see [`host`]), then reads the stdout it
+/// wrote a line at a time (see [`keep_lines`]) and its stderr whole.
+#[cfg(target_os = "wasi")]
+fn run_veripb(args: &[OsString], consume: &mut dyn FnMut(&str) -> bool) -> anyhow::Result<Output> {
+    let code = host::run(args)?;
+    let stdout = std::fs::File::open(host::STDOUT_PATH).context("failed to read veripb's stdout")?;
+    let stdout = keep_lines(std::io::BufReader::new(stdout), consume)
+        .context("failed to read veripb's stdout")?;
+    let stderr = std::fs::read(host::STDERR_PATH).context("failed to read veripb's stderr")?;
+    Ok(Output {
+        stdout,
+        stderr: String::from_utf8_lossy(&stderr).into_owned(),
+        success: code == 0,
+        code: Some(code),
+    })
+}
+
 /// Reads `reader` a line at a time, returning the lines (newlines kept)
 /// that `consume` does not take.
 fn keep_lines(
@@ -272,3 +293,42 @@ fn missing_dump_error(raw: &RawInvocation, flag: &str) -> anyhow::Error {
         super::parse::rejection_reason(&combined)
     )
 }
+
+/// WASI builds have no subprocesses: the host runs `veripb` on the shared
+/// filesystem instead.
+#[cfg(target_os = "wasi")]
+mod host {
+    use std::ffi::OsString;
+
+    use anyhow::Context;
+
+    #[link(wasm_import_module = "veripb_host")]
+    unsafe extern "C" {
+        /// Runs `veripb` with the given arguments (NUL-terminated UTF-8
+        /// strings, without `argv[0]`) and returns its exit code, or a
+        /// negative value if it could not be run. Writes its stdout and
+        /// stderr to [`STDOUT_PATH`] and [`STDERR_PATH`].
+        fn run_veripb(args_ptr: *const u8, args_len: usize) -> i32;
+    }
+
+    pub const STDOUT_PATH: &str = "/.tmp/.veripb-stdout";
+    pub const STDERR_PATH: &str = "/.tmp/.veripb-stderr";
+
+    /// Runs `veripb` with `args` and returns its exit code; its output is in
+    /// [`STDOUT_PATH`] and [`STDERR_PATH`].
+    pub fn run(args: &[OsString]) -> anyhow::Result<i32> {
+        let mut argv = Vec::new();
+        for arg in args {
+            let arg = arg
+                .to_str()
+                .with_context(|| format!("non-UTF-8 veripb argument {arg:?}"))?;
+            argv.extend_from_slice(arg.as_bytes());
+            argv.push(0);
+        }
+        let code = unsafe { run_veripb(argv.as_ptr(), argv.len()) };
+        if code < 0 {
+            anyhow::bail!("the host could not run veripb (code {code})");
+        }
+        Ok(code)
+    }
+}
