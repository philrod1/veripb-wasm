diff --git a/src/checker/invoke.rs b/src/checker/invoke.rs
index f7d5e12..c9be105 100644
--- a/src/checker/invoke.rs
+++ b/src/checker/invoke.rs
@@ -7,6 +7,7 @@ use std::path::{Path, PathBuf};
 
 use anyhow::Context;
 
+#[cfg(not(target_os = "wasi"))]
 /// Returns the `veripb` binary to invoke: `$VERIPB_REPL_VERIPB_BIN` if
 /// set, otherwise `"veripb"` resolved via `$PATH`.
 fn veripb_binary() -> std::ffi::OsString {
@@ -56,23 +57,43 @@ where
 
     let proof_file_path = proof_file.path().to_path_buf();
 
-    let output = std::process::Command::new(veripb_binary())
-        .arg(formula_path)
-        .arg(&proof_file_path)
-        .args(extra_args)
-        .output()
-        .with_context(|| {
-            format!(
-                "failed to run `{}` — is it installed and on PATH?",
-                veripb_binary().to_string_lossy()
-            )
-        })?;
+    #[cfg(not(target_os = "wasi"))]
+    let (stdout, stderr, success, code) = {
+        let output = std::process::Command::new(veripb_binary())
+            .arg(formula_path)
+            .arg(&proof_file_path)
+            .args(extra_args)
+            .output()
+            .with_context(|| {
+                format!(
+                    "failed to run `{}` — is it installed and on PATH?",
+                    veripb_binary().to_string_lossy()
+                )
+            })?;
+        (
+            output.stdout,
+            output.stderr,
+            output.status.success(),
+            output.status.code(),
+        )
+    };
+
+    #[cfg(target_os = "wasi")]
+    let (stdout, stderr, success, code) = {
+        let mut args = vec![
+            formula_path.as_os_str().to_os_string(),
+            proof_file_path.as_os_str().to_os_string(),
+        ];
+        args.extend(extra_args.into_iter().map(|s| s.as_ref().to_os_string()));
+        let output = host::run(&args)?;
+        (output.stdout, output.stderr, output.code == 0, Some(output.code))
+    };
 
     Ok(RawInvocation {
-        stdout: String::from_utf8_lossy(&output.stdout).into_owned(),
-        stderr: String::from_utf8_lossy(&output.stderr).into_owned(),
-        success: output.status.success(),
-        code: output.status.code(),
+        stdout: String::from_utf8_lossy(&stdout).into_owned(),
+        stderr: String::from_utf8_lossy(&stderr).into_owned(),
+        success,
+        code,
         proof_file_path,
         formula_file_path: formula_path.to_path_buf(),
     })
@@ -194,3 +215,50 @@ fn missing_dump_error(raw: &RawInvocation, flag: &str) -> anyhow::Error {
         super::parse::rejection_reason(&combined)
     )
 }
+
+/// WASI builds have no subprocesses: the host runs `veripb` on the shared
+/// filesystem instead.
+#[cfg(target_os = "wasi")]
+mod host {
+    use std::ffi::OsString;
+
+    use anyhow::Context;
+
+    #[link(wasm_import_module = "veripb_host")]
+    unsafe extern "C" {
+        /// Runs `veripb` with the given arguments (NUL-terminated UTF-8
+        /// strings, without `argv[0]`) and returns its exit code, or a
+        /// negative value if it could not be run. Writes its stdout and
+        /// stderr to [`STDOUT_PATH`] and [`STDERR_PATH`].
+        fn run_veripb(args_ptr: *const u8, args_len: usize) -> i32;
+    }
+
+    const STDOUT_PATH: &str = "/tmp/.veripb-stdout";
+    const STDERR_PATH: &str = "/tmp/.veripb-stderr";
+
+    pub struct Output {
+        pub stdout: Vec<u8>,
+        pub stderr: Vec<u8>,
+        pub code: i32,
+    }
+
+    pub fn run(args: &[OsString]) -> anyhow::Result<Output> {
+        let mut argv = Vec::new();
+        for arg in args {
+            let arg = arg
+                .to_str()
+                .with_context(|| format!("non-UTF-8 veripb argument {arg:?}"))?;
+            argv.extend_from_slice(arg.as_bytes());
+            argv.push(0);
+        }
+        let code = unsafe { run_veripb(argv.as_ptr(), argv.len()) };
+        if code < 0 {
+            anyhow::bail!("the host could not run veripb (code {code})");
+        }
+        Ok(Output {
+            stdout: std::fs::read(STDOUT_PATH).context("failed to read veripb's stdout")?,
+            stderr: std::fs::read(STDERR_PATH).context("failed to read veripb's stderr")?,
+            code,
+        })
+    }
+}
