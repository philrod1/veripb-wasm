From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Phil Rodgers <philip.rodgers@glasgow.ac.uk>
Date: Fri, 23 Oct 2026 10:37:09 +0000
Subject: [PATCH 4/4] Make the session's undo snapshots public

Visibility only: Snapshot, Session::snapshot, Session::push_undo and
Session::generation become pub, so a frontend outside the crate can
record a buffer edit as one undoable action, as the TUI's Vim mode does.
---
 src/session.rs | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/src/session.rs b/src/session.rs
index 6004d57..26623fc 100644
--- a/src/session.rs
+++ b/src/session.rs
@@ -29,7 +29,7 @@ use crate::varnames::VarNames;
 const PREAMBLE_LINES: usize = 2;
 
 /// One `:undo`-stack entry: the state `restore_snapshot` restores.
-pub(crate) struct Snapshot {
+pub struct Snapshot {
     formula: Vec<String>,
     objective: Option<String>,
     preserved: Option<String>,
@@ -97,7 +97,7 @@ pub struct Session {
     /// Bumped on every successful mutation of `formula`/`objective`/`buffer`/
     /// `checked_len`. `commands::dispatch` uses it to decide whether to push
     /// an undo entry; `database_cache` is refreshed only when it changes.
-    pub(crate) generation: u64,
+    pub generation: u64,
     /// Pre-action snapshots, most recent last; capped at `UNDO_STACK_CAP`.
     pub(crate) undo_stack: VecDeque<Snapshot>,
     /// Buffer indices with a breakpoint. Not proof state: excluded from
@@ -672,7 +672,7 @@ impl Session {
     }
 
     /// Captures the current state for [`Self::restore_snapshot`].
-    pub(crate) fn snapshot(&self) -> Snapshot {
+    pub fn snapshot(&self) -> Snapshot {
         Snapshot {
             formula: self.formula.clone(),
             objective: self.objective.clone(),
@@ -686,7 +686,7 @@ impl Session {
 
     /// Pushes `snapshot` onto the undo stack, dropping the oldest entry at
     /// `UNDO_STACK_CAP`.
-    pub(crate) fn push_undo(&mut self, snapshot: Snapshot) {
+    pub fn push_undo(&mut self, snapshot: Snapshot) {
         if self.undo_stack.len() == UNDO_STACK_CAP {
             self.undo_stack.pop_front();
         }
